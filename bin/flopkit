#!/usr/bin/env python3
"""flopkit launcher — run from anywhere.

Usage:
  python3 /home/null/flop-toolkit/bin/flopkit status
  python3 /home/null/flop-toolkit/bin/flopkit cycle --dry-run
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from flopkit.__main__ import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
